{
  "name": "storepix",
  "version": "0.2.0",
  "description": "Generate beautiful App Store screenshots with HTML/CSS templates",
  "type": "module",
  "bin": {
    "storepix": "./src/cli.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "prepublishOnly": "npm test && node src/cli.js --help > /dev/null",
    "test:render": "node --test tests/render/*.test.js",
    "docs:templates": "node scripts/template-list.js",
    "check:docs": "node scripts/template-list.js --check"
  },
  "keywords": [
    "app-store",
    "screenshots",
    "marketing",
    "ios",
    "mockup",
    "playwright"
  ],
  "author": "Jan Schroeder",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Madnex/storepix.git"
  },
  "bugs": {
    "url": "https://github.com/Madnex/storepix/issues"
  },
  "homepage": "https://github.com/Madnex/storepix#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "playwright": "^1.63.0",
    "serve-handler": "^6.1.7",
    "sharp": "^0.35.5"
  }
}
